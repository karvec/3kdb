#class {unique_items} {kill};
#class {unique_items} {open};

#NOP -- Unique items: a second copy explodes a round or two after you pick it up ("<item> shudders and trembles in;
#NOP -- the presence of another of its kind and explodes!"), mostly from the corpse get all. When get all picks up a;
#NOP -- second copy of one listed here, it's dropped at once so another character can have it. If its tier word is;
#NOP -- better than yours, that's announced and the bot pauses so you can swap them by hand;
#NOP -- key: the word drop needs. tiers: the tier words from worst to best (WMT's Celestial Zodiacs scaler table and;
#NOP -- our logs). malicious (sword) and tattered (grimoire) aren't on WMT and are guessed to be the lowest;
#var uniqueItems {
    {Helmet of Aeonos} {{key} {helmet} {tiers} {dim;gleaming;shining;luminous;radiant;transcendent}}
    {Jade Shield of Felines} {{key} {shield} {tiers} {moderate;remarkable;unbelievable}}
    {Celestial Tome of Aeonos} {{key} {tome} {tiers} {dim;gleaming;luminous;brilliant;divine;transcendent}}
    {Grimoire of Zephyrak} {{key} {grimoire} {tiers} {tattered;weathered;arcane;cryptic;esoteric}}
    {Zephyrak's Sword of Wrath} {{key} {sword} {tiers} {malicious;vicious;horrific;apocalyptic;malevolent}}
};

#NOP -- The names as one regex alternative for the actions below;
#var uniqueAlt {};
#foreach {*uniqueItems[]} {_u} {#if {"$uniqueAlt" == ""} {#var uniqueAlt {$_u}} {#var uniqueAlt {$uniqueAlt|$_u}}};

#NOP -- uniqueOwned[<name>] is the tier of the copy you have. It's set from inventory rows (" 1 *Helmet of Aeonos;
#NOP -- (luminous) (worn on head).") and pickups, and cleared when it leaves. Until the first i after login it's;
#NOP -- unknown, so nothing is dropped;
#action {{^\s*\d+ \*?($uniqueAlt) \((\w+)\)}} {#var uniqueOwned[%2] {%3}} {2};
#action {{^You get ($uniqueAlt) \((\w+)\) from }} {.uniquePickup {%2} {%3}} {2};
#NOP -- get all says "<item>: Ok." per item. actions.tin's priority-4 "%*: Ok." clears encumbrance, so this one does too;
#action {{^($uniqueAlt) \((\w+)\): Ok\.$}} {
    #var inventory[encumberance] 0;
    .uniquePickup {%2} {%3};
} {2};
#NOP -- Leaving: put, drop or give. The drop .uniquePickup sends for a second copy doesn't count;
#action {{^You (put|drop|give) ($uniqueAlt) \((\w+)\)}} {
    #if {&uniqueDropping[%3]} {
        #unvar uniqueDropping[%3];
        #return;
    };
    #unvar uniqueOwned[%3];
} {2};
#action {{^($uniqueAlt) \((\w+)\) shudders and trembles in}} {
    #echo {<faa>UNIQUE: a second %2 (%3) exploded before it could be dropped<088>};
} {2};

#NOP -- .uniquePickup <name> <tier>: the first copy is just remembered. A second one is dropped (the newest copy is;
#NOP -- found first and yours is usually kept), and if its tier is better than yours the bot pauses;
#alias {.uniquePickup} {
    #local _new 0;
    #local _old 0;
    #if {!&uniqueOwned[%1]} {
        #var uniqueOwned[%1] {%2};
        #return;
    };
    #if {$idle_flag} {#return};
    #var uniqueDropping[%1] 1;
    #send {drop $uniqueItems[%1][key]};
    #list uniqueTiers create {$uniqueItems[%1][tiers]};
    #list uniqueTiers find {%2} _new;
    #list uniqueTiers find {$uniqueOwned[%1]} _old;
    #if {$_new && $_old && $_new > $_old} {
        .notify {<fcb>UNIQUE UPGRADE<ddd> %1 (%2) beats your ($uniqueOwned[%1]), dropped at $roomvnum. Swap them by hand};
        #echo {<cfb>===========> <ccd>UPGRADE: %1 (%2) beats your ($uniqueOwned[%1]). Dropped it so it can't explode<088>};
        #if {$bot[active] && !$bot[paused]} {.pause};
        #return;
    };
    .notify {<fcb>UNIQUE<ddd> dropped a second %1 (%2) at $roomvnum, you have ($uniqueOwned[%1])};
    #echo {<cfb>===========> <ccd>Dropped a second %1 (%2) so it can't explode. Yours: ($uniqueOwned[%1])<088>};
};

#class {unique_items} {close};
