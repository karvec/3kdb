#class {area_westersea} {kill};
#class {area_westersea} {open};

#NOP -- CITY OF WESTERSEA MISSION HELPER;
#NOP -- Solutions come from the wemudtogether.com Westersea guide (fantasy page) and karvec's logs.;
#NOP -- Type wsea for the command list.  Room numbers are from common/map/3k_shared.map.;

#NOP -- Where each mission is handed in.  Keys are the lower case mission names from the book.;
#NOP -- cmd is sent at the giver, how is the hint wsea book shows while the mission is open.;
#var wsea_db {
    {scout the town}        {{giver} {Tinny} {vnum} {4757} {cmd} {say complete} {how} {walk the encampment SW of Tinny, then from Tinny all e, ne, n, examine trees, examine vegetation, push aside branches}}
    {scout the realm}       {{giver} {Tinny} {vnum} {4757} {cmd} {say complete} {how} {wsea scout for the three areas}}
    {sewer cleanup}         {{giver} {Tinny} {vnum} {4757} {cmd} {say complete} {how} {+wsea-sewer, or wsea grind sewer to repeat it for rep}}
    {grab guard reports}    {{giver} {Captain Mayne} {vnum} {5805} {cmd} {say complete} {how} {wsea reports walks the walls and grabs every desk}}
    {report fight to mayne} {{giver} {Captain Mayne} {vnum} {5805} {cmd} {say complete} {how} {kill the spy that jumps you on the walls}}
    {fortify westersea}     {{giver} {Captain Mayne} {vnum} {5805} {cmd} {say complete} {how} {wsea fortify, wait for Bern, then wsea chests}}
    {find the lieutenant}   {{giver} {Captain Mayne} {vnum} {5805} {cmd} {say complete} {how} {wsea lieutenant}}
    {inform the widow}      {{giver} {Captain Mayne} {vnum} {5805} {cmd} {say complete} {how} {wsea widow}}
    {slum cleanup}          {{giver} {Captain Mayne} {vnum} {5805} {cmd} {say complete} {how} {+wsea-slum, or wsea grind slum to repeat it for rep}}
    {eavesdropping}         {{giver} {Captain Mayne} {vnum} {5805} {cmd} {say complete} {how} {wsea eavesdrop}}
    {city volunteers}       {{giver} {Captain Mayne} {vnum} {5805} {cmd} {say complete} {how} {wsea lamps, then walk the streets}}
    {deliver sewer report}  {{giver} {Captain Mayne} {vnum} {5805} {cmd} {give report to mayne;say complete} {how} {wsea turnin}}
    {longtooth's defeat}    {{giver} {Jainie Markson} {vnum} {5820} {cmd} {say complete} {how} {kill Longtooth in the sewers}}
    {kail's defeat}         {{giver} {Jainie Markson} {vnum} {5820} {cmd} {say complete} {how} {kill Pretty boy Kail}}
    {caught a fish?}        {{giver} {Sain Ash} {vnum} {5810} {cmd} {give 10 acota fish to sain} {how} {bait rod with meat, thread line, catch 10 acota fish}}
    {sewer excursion}       {{giver} {Alister} {vnum} {5850} {cmd} {say complete} {how} {wsea excursion}}
    {a hungry guard}        {{giver} {Tommy} {vnum} {6202} {cmd} {give roll to tommy} {how} {wsea rolls}}
    {an unwelcome visitor}  {{giver} {Tommy} {vnum} {6202} {cmd} {say complete} {how} {wsea visitor 1, 2, then 3}}
    {send word to alister}  {{giver} {Alister} {vnum} {5850} {cmd} {say it's time;say mission} {how} {wsea visitor 3}}
    {find the church tomb}  {{giver} {Alister} {vnum} {5850} {cmd} {say complete;say mission} {how} {wsea tapestry, then wsea belfry}}
    {explore church tomb}   {{giver} {Alister} {vnum} {5850} {cmd} {say complete} {how} {wsea karithal male or female}}
    {church tomb cleanup}   {{giver} {Alister} {vnum} {5850} {cmd} {say complete} {how} {wsea eggs, then the holes (wsea help)}}
    {make contact}          {{giver} {Alister} {vnum} {5850} {cmd} {say complete} {how} {wsea contact, finish Assist Presence, then say history at the sphere}}
    {assist presence}       {{giver} {} {vnum} {} {cmd} {} {how} {wsea presence (needs lockpicking and alchemy)}}
    {slay dotar}            {{giver} {} {vnum} {} {cmd} {} {how} {go wsea_dotar, kill the blockers, w, kill dotar (use fire)}}
    {lacking strength}      {{giver} {} {vnum} {} {cmd} {} {how} {push cart east of the church, needs about 800 combined STR}}
};


#var wsea {{quiet} {0} {parsing} {0} {lamps} {0} {grind} {} {then} {} {rep} {0}};
#var wsea_lamps {};

#NOP -- MISSION BOOK PARSER;
#NOP -- flip/browse prints a table.  Every row is stored in wsea[book][Mission][Task] = percent.;
#NOP -- wsea[quiet] gags the table when the helper sent flip itself.;
#action {^| #|%sMISSION%s|%*|} {
    #unvar wsea[book];
    #var wsea[parsing] 1;
    #if {$wsea[quiet]} {#line gag};
} {4};

#action {^|%s{\d+}|%*|%s|%s|$} {
    #if {$wsea[parsing]} {
        #format wsea[current] {%p} {%3};
        #if {$wsea[quiet]} {#line gag};
    };
} {4};

#action {^|  |%s|%*|%s{\d+}%s|$} {
    #if {$wsea[parsing]} {
        #format tmpTask {%p} {%2};
        #var {wsea[book][$wsea[current]][$tmpTask]} {%4};
        #if {$wsea[quiet]} {#line gag};
    };
} {4};

#action {^{\.--\.|\|--\+}%*} {#if {$wsea[parsing] && $wsea[quiet]} {#line gag}} {4};

#action {^!--!%*} {
    #if {$wsea[parsing]} {
        #var wsea[parsing] 0;
        #if {$wsea[quiet]} {#line gag};
        #var wsea[quiet] 0;
        #NOP -- Whatever asked for the book runs now that it is parsed;
        #switch {"$wsea[then]"} {
            #case {"show"} {.wsea_show};
            #case {"turnin"} {.wsea_turnin};
            #case {"grindstart"} {.wsea_grind_start};
            #case {"grindsync"} {.wsea_grind_count;.wsea_grind_after};
        };
        #var wsea[then] {};
    };
} {4};

#NOP -- Sets wsea_isdone to 1 when every task of mission %1 is at 100;
#alias .wsea_done {
    #var wsea_isdone 1;
    #foreach {*wsea[book][%1][]} {tmpTask} {
        #if {${wsea[book][%1][$tmpTask]} < 100} {#var wsea_isdone 0};
    };
};

#NOP -- Current Westersea rep from common/reps.tin, 0 if it has not been read yet;
#alias .wsea_rep {
    #var wsea[rep] 0;
    #var tmpIx 0;
    #if {&repData[]} {
        #list repData indexate rep_key;
        #list repData find {The City of Westersea} tmpIx;
    };
    #if {$tmpIx} {
        #if {"$repData[$tmpIx][current_value]" != ""} {#var wsea[rep] $repData[$tmpIx][current_value]};
    };
};

#alias .wsea_show {
    .wsea_rep;
    #echo {<fff>  Westersea missions<088>   <cdd>rep: $wsea[rep]   (An Unwelcome Visitor needs about 100k)<088>};
    #foreach {*wsea[book][]} {tmpMission} {
        .wsea_done {$tmpMission};
        #format tmpKey {%l} {$tmpMission};
        #if {$wsea_isdone} {
            #if {"$wsea_db[$tmpKey][giver]" != ""} {
                #echo {<afa>  $tmpMission<088> - done, hand in to $wsea_db[$tmpKey][giver] (wsea turnin)};
            } {
                #echo {<afa>  $tmpMission<088> - done};
            };
        } {
            #if {"$wsea_db[$tmpKey][how]" != ""} {
                #echo {<ffa>  $tmpMission<088> - $wsea_db[$tmpKey][how]};
            } {
                #echo {<ffa>  $tmpMission<088> - not in the helper yet};
            };
        };
    };
};

#NOP -- Walks to each giver with a finished mission and hands it in;
#alias .wsea_turnin {
    #var tmpCount 0;
    #foreach {*wsea[book][]} {tmpMission} {
        .wsea_done {$tmpMission};
        #format tmpKey {%l} {$tmpMission};
        #if {$wsea_isdone && "$wsea_db[$tmpKey][vnum]" != ""} {
            #echo {<afa>Westersea: handing in $tmpMission to $wsea_db[$tmpKey][giver]<088>};
            #map run $wsea_db[$tmpKey][vnum];
            #foreach {$wsea_db[$tmpKey][cmd]} {tmpCmd} {$tmpCmd};
            #math tmpCount {$tmpCount + 1};
        };
    };
    #if {$tmpCount == 0} {#echo {<ffa>Westersea: nothing in the book is finished yet.<088>}};
};


#NOP -- GRIND: repeat sewer or slum cleanup for rep (from karvec's old wsea_combined + wsea_mission_parser);
#NOP -- Kills are counted per task, mobs whose task is done are left alone for the next round, and at 100 the;
#NOP -- bot pauses where it is, hands in, takes the mission again, walks back and carries on from the same step.;

#NOP -- Kills each task needs;
#var wsea_grindneed {
    {Sewer Cleanup} {{Vanquish sewer monster} {20}}
    {Slum Cleanup} {{Dispose of shady leaders} {3} {Dispose of brigands} {5} {Dispose of ruffians} {10}}
};

#NOP -- Slum kills by the name in the death message (lower case): the task and the bot target line.;
#NOP -- Every sewer monster counts for the one sewer task, so the sewer bot keeps its own mob list;
#var wsea_slummobs {
    {shady leader} {{task} {Dispose of shady leaders} {long} {Shady leader} {target} {leader}}
    {tough looking brigand} {{task} {Dispose of brigands} {long} {Tough looking brigand} {target} {brigand}}
    {mischievous ruffian} {{task} {Dispose of ruffians} {long} {Mischievous ruffian} {target} {ruffian}}
};

#alias .wsea_grind {
    #var tmpOk 1;
    #switch {"%1"} {
        #case {"sewer"} {#var wsea[grind] {Sewer Cleanup};#var wsea[grindbot] {wsea-sewer}};
        #case {"slum"} {#var wsea[grind] {Slum Cleanup};#var wsea[grindbot] {wsea-slum}};
        #default {#var tmpOk 0;#echo {<ffa>usage: wsea grind sewer|slum<088>}};
    };
    #if {$tmpOk} {
        #var wsea[runs] 0;
        #var wsea[turnin] 0;
        #echo {<afa>Westersea: grinding $wsea[grind].  wsea stop ends it.<088>};
        #NOP -- Read the book first so kills already made this round are counted;
        #var wsea[quiet] 1;
        #var wsea[then] grindstart;
        flip;
    };
};

#NOP -- wsea[left][task] = kills still needed, from the book (or the full amount if %1 is full);
#alias .wsea_grind_count {
    #unvar wsea[left];
    #foreach *wsea_grindneed[$wsea[grind]][] tmpTask {
        #var tmpNeed $wsea_grindneed[$wsea[grind]][$tmpTask];
        #var tmpPct 0;
        #if {"%1" != "full" && &wsea[book][$wsea[grind]][]} {
            #if {&wsea[book][$wsea[grind]][$tmpTask]} {#var tmpPct $wsea[book][$wsea[grind]][$tmpTask]};
        };
        #math tmpDone {($tmpPct * $tmpNeed + 50) / 100};
        #format tmpDone {%d} {$tmpDone};
        #math {wsea[left][$tmpTask]} {$tmpNeed - $tmpDone};
    };
};

#alias .wsea_grind_left {
    #var wsea_grind_total 0;
    #foreach *wsea[left][] tmpTask {
        #if {$wsea[left][$tmpTask] > 0} {#math wsea_grind_total {$wsea_grind_total + $wsea[left][$tmpTask]}};
    };
};

#NOP -- Called once the book is read at the start;
#alias .wsea_grind_start {
    #format tmpKey {%l} {$wsea[grind]};
    #var wsea[handstep] {};
    #if {&wsea[book][$wsea[grind]][]} {
        .wsea_grind_count;
        .wsea_grind_left;
        #if {$wsea_grind_total == 0} {
            #echo {<afa>Westersea: $wsea[grind] is already done - handing it in first.<088>};
            #var wsea[handstep] complete;
        };
    } {
        #echo {<afa>Westersea: taking $wsea[grind] from $wsea_db[$tmpKey][giver] first.<088>};
        #var wsea[handstep] take;
    };
    #if {"$wsea[handstep]" != ""} {
        #NOP -- The You add action starts the bot once the giver has handed the mission over;
        #var wsea[turnin] 1;
        #var wsea[resume] {};
        #map run $wsea_db[$tmpKey][vnum];
        .wsea_grind_say;
        #delay {wsea_handin_stuck} {
            #if {"$wsea[handstep]" != ""} {
                #echo {<faa>Westersea: no answer from the giver at step $wsea[handstep].  Sort it out by hand, then wsea grind again.<088>};
                #var wsea[handstep] {};
                #undelay {wsea_say_retry};
            };
        } {40};
        #return;
    };
    .wsea_grind_show;
    #if {$bot[active] && "$bot[alias]" == "$wsea[grindbot]"} {
        .wsea_grind_targets;
    } {
        +$wsea[grindbot];
        #NOP -- The bot file sets its mob list when it loads, 4 seconds after +;
        #delay {wsea_targets} {.wsea_grind_targets} {6};
    };
};

#alias .wsea_grind_show {
    #var tmpLine {};
    #foreach *wsea[left][] tmpTask {#var tmpLine {$tmpLine  $tmpTask: $wsea[left][$tmpTask]}};
    #echo {<afa>Westersea: $wsea[grind] kills left -$tmpLine<088>};
};

#NOP -- Slum: only the mobs whose task still needs kills are targets, so done ones stay up for the next round;
#alias .wsea_grind_targets {
    #if {"$wsea[grind]" != "Slum Cleanup" || !$bot[active]} {#return};
    #list bot[mobs] clear;
    #foreach *wsea_slummobs[] tmpMob {
        #var tmpTask {$wsea_slummobs[$tmpMob][task]};
        #if {$wsea[left][$tmpTask] > 0} {
            #list bot[mobs] add {{{long} {$wsea_slummobs[$tmpMob][long]} {target} {$wsea_slummobs[$tmpMob][target]}}};
        };
    };
};

#alias .wsea_grind_stop {
    #undelay {wsea_regrind};
    #undelay {wsea_targets};
    #unticker {wsea_turnin};
    #undelay {wsea_say_retry};
    #undelay {wsea_handin_stuck};
    #var wsea[handstep] {};
    #unticker {wsea_eavesdrop};
    #var wsea[rollstep] {};
    #undelay {wsea_rolls_stuck};
    #var wsea[grind] {};
    #var wsea[turnin] 0;
    #var wsea[lamps] 0;
    #if {$bot[active]} {.stop};
    #echo {<afa>Westersea helper stopped.<088>};
};

#NOP -- The death message comes just before the update, so deathReport[mob_killed] is the mob that counted;
#action {^You update the %* mission.$} {
    #format tmpKey {%l} {$wsea[grind]};
    #if {"$tmpKey" != "" && "%1" == "$tmpKey" && !$wsea[turnin]} {
        #var tmpTask {};
        #if {"$wsea[grind]" == "Sewer Cleanup"} {
            #var tmpTask {Vanquish sewer monster};
        } {
            #format tmpMob {%l} {$deathReport[mob_killed]};
            #if {&wsea_slummobs[$tmpMob]} {#var tmpTask {$wsea_slummobs[$tmpMob][task]}};
        };
        #if {"$tmpTask" == ""} {
            #NOP -- Don't know what counted, so read the book to get back in step;
            #var wsea[quiet] 1;
            #var wsea[then] grindsync;
            flip;
        } {
            #math {wsea[left][$tmpTask]} {$wsea[left][$tmpTask] - 1};
            .wsea_grind_after;
        };
    };
} {5};

#alias .wsea_grind_after {
    .wsea_grind_left;
    #if {$wsea_grind_total <= 0} {
        .wsea_grind_turnin;
    } {
        .wsea_grind_targets;
    };
};

#NOP -- Pause the bot here, wait out any fight, then hand in and come back;
#alias .wsea_grind_turnin {
    #var wsea[turnin] 1;
    #if {$bot[active]} {.pause};
    #map get roomvnum wsea[resume];
    #ticker {wsea_turnin} {#if {!$incombat} {#unticker {wsea_turnin};.wsea_grind_handin}} {1};
};

#NOP -- Each say waits for the giver's answer: a giver still talking ignores you ("You politely refuse to;
#NOP -- interrupt"), which once lost the retake.  [handstep] is complete, then take, then empty when done;
#alias .wsea_grind_handin {
    #format tmpKey {%l} {$wsea[grind]};
    #math wsea[runs] {$wsea[runs] + 1};
    .wsea_rep;
    #echo {<afa>Westersea: $wsea[grind] done ($wsea[runs] this session, rep $wsea[rep]) - handing in, taking it again and coming back.<088>};
    #map run $wsea_db[$tmpKey][vnum];
    #var wsea[handstep] complete;
    .wsea_grind_say;
    #delay {wsea_handin_stuck} {
        #if {"$wsea[handstep]" != ""} {
            #echo {<faa>Westersea: no answer from the giver at step $wsea[handstep] - the bot stays paused.  Sort it out by hand, then wsea grind again.<088>};
            #var wsea[handstep] {};
            #undelay {wsea_say_retry};
        };
    } {40};
};

#NOP -- Says it again every 4 seconds until the giver answers (the stuck delay gives up after 40);
#alias .wsea_grind_say {
    #format tmpKey {%l} {$wsea[grind]};
    #if {"$wsea[handstep]" == "complete"} {say complete};
    #if {"$wsea[handstep]" == "take"} {say $tmpKey};
    #if {"$wsea[handstep]" != ""} {#delay {wsea_say_retry} {.wsea_grind_say} {4}};
};

#action {^You politely refuse to interrupt %*.} {
    #if {"$wsea[handstep]" != ""} {#delay {wsea_say_retry} {.wsea_grind_say} {3}};
} {4};

#action {^As you complete the last task} {
    #if {"$wsea[handstep]" == "complete"} {
        #NOP -- The giver won't hand the mission out again for a second or two;
        #var wsea[handstep] take;
        #delay {wsea_say_retry} {.wsea_grind_say} {2.5};
    };
} {4};

#action {^You add %* as a mission in your book.} {
    #format tmpKey {%l} {$wsea[grind]};
    #if {"$wsea[handstep]" == "take" && "%1" == "$tmpKey"} {
        #var wsea[handstep] {};
        #undelay {wsea_handin_stuck};
        #undelay {wsea_say_retry};
        .wsea_grind_count full;
        .wsea_grind_show;
        #if {"$wsea[resume]" != ""} {#map run $wsea[resume]};
        #delay {wsea_regrind} {
            #var wsea[turnin] 0;
            #if {$bot[active]} {.wsea_grind_targets;..} {+$wsea[grindbot];#delay {wsea_targets} {.wsea_grind_targets} {6}};
        } {2};
    };
} {4};


#NOP -- GUARD AND CITY WORK;

#NOP -- Fortify Westersea: Bern makes the gear from Mayne's note, wsea chests delivers it;
#alias .wsea_fortify {
    #map run 5814;
    give note to bern;
    #echo {<ffa>Wait for Bern to finish the weapons and armour, then type wsea chests.<088>};
};

#NOP -- The six chests: NE tower, SE tower, SE station, SW tower bartizan, western station, fair station;
#alias .wsea_chests {
    #map run 6024;fortify chest;
    #map run 6096;fortify chest;
    #map run 5884;fortify chest;
    #map run 6067;fortify chest;
    #map run 5987;fortify chest;
    #map run 5992;fortify chest;
    #map run 5805;say complete;
};

#NOP -- Eavesdropping: the merchants are east of the castle entry, but it only works from the path below it;
#alias .wsea_eavesdrop {
    #map run 5926;
    d;e;
    eavesdrop;
    #ticker {wsea_eavesdrop} {eavesdrop} {5};
    #delay {wsea_eavesdrop_stop} {#unticker {wsea_eavesdrop}} {90};
};
#action {^You update the eavesdropping mission.$} {#unticker {wsea_eavesdrop};#undelay {wsea_eavesdrop_stop}} {4};

#NOP -- City Volunteers: examine every street lamp seen while this is on;
#action {^-i-A street lamp.$} {
    #if {$wsea[lamps]} {
        #map get roomvnum tmpVnum;
        #if {!&wsea_lamps[$tmpVnum]} {
            #var wsea_lamps[$tmpVnum] 1;
            examine lamp;
        };
    };
} {1};

#NOP -- A Hungry Guard: Bern sells the steel bowls (item 5), Per trades one roll per bowl, Tommy takes the rolls.;
#NOP -- Per takes a bowl only once he has finished explaining the deal, and one at a time: each takes him a few;
#NOP -- seconds and a bowl given meanwhile is refused ("You decide not to give that to Per Tussletoff right now.").;
#NOP -- Tommy also takes one roll at a time. So each give waits for the answer to the last (seen 2026-10-17);
#alias .wsea_rolls {
    #map run 5814;#5 buy 5;
    #map run 45753;
    #var wsea[rolls] 0;
    #var wsea[rollstep] per;
    say honey glazed vanilla rolls;
    .wsea_rolls_wait;
};
#alias .wsea_rolls_wait {
    #delay {wsea_rolls_stuck} {
        #var wsea[rollstep] {};
        #echo {<faa>wsea rolls: no answer from Per or Tommy for a minute, stopped.<088>};
    } {60};
};
#action {^Per continues: For each steel bowl or set of steel bells you give} {
    #if {"$wsea[rollstep]" == "per"} {give bowl to per};
} {4};
#action {^Per hands a sizzling warm vanilla roll to you.$} {
    #if {"$wsea[rollstep]" == "per"} {
        #math wsea[rolls] {$wsea[rolls] + 1};
        .wsea_rolls_wait;
        #if {$wsea[rolls] < 5} {give bowl to per} {
            #var wsea[rollstep] tommy;
            #var wsea[rolls] 0;
            #map run 6202;
            give roll to tommy;
        };
    };
} {4};
#action {^Tommy crams the tasty rolls and mumbles a muffled: Thank you.$} {
    #if {"$wsea[rollstep]" == "tommy"} {
        #math wsea[rolls] {$wsea[rolls] + 1};
        .wsea_rolls_wait;
        #if {$wsea[rolls] < 5} {give roll to tommy} {
            #var wsea[rollstep] {};
            #undelay {wsea_rolls_stuck};
        };
    };
} {4};


#NOP -- MAIN LINE;

#NOP -- An Unwelcome Visitor, from Tommy.  1 is Lady Anne and Sir Michael, 2 is Ashton, 3 hands the note on;
#alias .wsea_visitor {
    #switch {"%1"} {
        #case {"1"} {
            .wsea_rep;
            #if {$wsea[rep] == 0} {#echo {<faa>Westersea rep has not been read yet - type reps first so Sir Michael can be checked.<088>}};
            #if {$wsea[rep] > 0 && $wsea[rep] < 45000} {#echo {<faa>Westersea rep is $wsea[rep].  Lady Anne talked at 45k.<088>}};
            #map run 5879;say ivar cutters;
            #if {$wsea[rep] >= 100000} {
                #map run 5932;say ivar cutters;say jan trotters;
            } {
                #if {$wsea[rep] > 0} {#echo {<faa>Westersea rep is $wsea[rep].  Sir Michael wants about 100k (91.8k was not enough) - grind sewer/slum first.<088>}};
            };
        };
        #case {"2"} {#map run 5831;say tom fablepott;kill ashton};
        #case {"3"} {
            #map run 6202;give note to tommy;give note to tommy;
            #map run 5850;say it's time;say mission;
        };
        #default {#echo {<ffa>usage: wsea visitor 1|2|3  (1 Lady Anne + Sir Michael, 2 kill Ashton, 3 note to Tommy then Alister)<088>}};
    };
};
#action {^Ashton Nibble gasps for breath, then slumps into death.} {get note from corpse} {5};

#NOP -- Find the Church Tomb part 1: the tapestry in the east passage, then the hidden back room;
#alias .wsea_tapestry {
    #map run 5849;
    #4 turn left dial;#3 turn centre dial;#5 turn right dial;
    push explosion;push boulder;push orb;push vase;
    search items;search something;
    push button;
};

#NOP -- Part 2: fix the belfry cord for the chisel, then carve the inscription at Alister;
#alias .wsea_belfry {
    #map run 5856;pull cord;repair cord;pull cord;
    #map run 5850;
    examine table cloth;search table cloth;examine inscription;read inscription;
    carve e;insert candle into hole;
    say complete;say mission;
};

#NOP -- Explore Church Tomb: say your name in Karithal at the barrier three rooms below Alister;
#NOP -- Reverse the name, add s (male) or k (female), vowels become -, m nrp, then r pr (so nrp becomes nprp), k klp, s zz;
#function wsea_karithal {
    #format result {%l} {%1};
    #format result {%r} {$result};
    #if {"%2" == "female"} {#cat result k} {#cat result s};
    #foreach {a;e;i;o;u;y} {tmpVowel} {#replace result {$tmpVowel} {-}};
    #replace result {m} {nrp};
    #replace result {r} {pr};
    #replace result {k} {klp};
    #replace result {s} {zz};
};

#alias .wsea_karithal {
    #if {"%1" != "male" && "%1" != "female"} {
        #echo {<ffa>usage: wsea karithal male|female<088>};
    } {
        #var tmpKarithal @wsea_karithal{$user;%1};
        #echo {<afa>Westersea: $user in Karithal is $tmpKarithal<088>};
        #map run 5859;
        murmur $tmpKarithal;
    };
};

#NOP -- Church Tomb Cleanup: the first egg in the western branch holds the cocoon;
#alias .wsea_eggs {
    #map run 5868;
    crack egg;
    #echo {<ffa>Keep cracking eggs until none are left.  Then next room: insert hand in left/centre/right hole, killing what comes out.  Then the outer right branch holes.<088>};
};

#NOP -- Make Contact: touch the sphere (map exit from 5871), that hands you Assist Presence;
#alias .wsea_contact {
    #map run 50358;
    #echo {<ffa>After Assist Presence is done, come back here and say history, listen to the end, then wsea turnin.<088>};
};

#NOP -- Assist Presence: chirping box from Jorbin goes into the wall behind the library buttons;
#alias .wsea_presence {
    #map run 45572;buy 7;
    #map run 20700;
    #4 press left button;#8 press right button;
    plant chirping box;
    #echo {<ffa>Then collect the dust in the future mansion, refine it into copperas with alchemy and sprinkle copperas on sphere.<088>};
};


#NOP -- Scout the Town and Scout the Realm update when you walk into one room per task. Rooms from karvec's;
#NOP -- logs (2026-10-16 and 17), all on the shared map: Town northern mountain chain 42827 At a frozen glade (the;
#NOP -- hidden path north of the clearing 4746, the map's pushbranches exit). Faeries 37171 In the shade of an ash;
#NOP -- tree. Desert: the push right eye exit from the hole 26553 into 26554. Wasteland 16004 Approach to Medlar;
#NOP -- (e,s,n,w), one step w of 16002. The Town encampment room isn't in the logs;
#alias .wsea_scout {
    #switch {"%1"} {
        #case {"town"} {#map run 42827};
        #case {"faeries"} {#map run 37171};
        #case {"wasteland"} {
            #echo {<faa>Snow Wasteland rooms scramble your moves. If the walk stops, step back to 16002 and go w.<088>};
            #map run 16004;
        };
        #case {"desert"} {
            #map run 26553;
            #echo {<cdd>Now: examine drawing 1-4, push left eye, kill the snakes, walk like an egyptian, push right eye.<088>};
            #echo {<cdd>The push updates the mission. Answer no to leave the short way (then e, portal, u, trail).<088>};
        };
        #default {
            #echo {<fff>  Scout the Town / Scout the Realm - each task updates when you walk into its room, then wsea turnin<088>};
            #echo {<cdd>  wsea scout town      : walk to 42827 At a frozen glade (northern mountain chain, through the hidden path)<088>};
            #echo {<cdd>                         The encampment task: walk around the area just south-west of Tinny.<088>};
            #echo {<cdd>  wsea scout faeries   : walk to 37171 In the shade of an ash tree<088>};
            #echo {<cdd>  wsea scout wasteland : walk to 16004 Approach to Medlar (Medlar Castle).  Do NOT stepper out with go magic/go anywhere - a mob there makes you drop all.<088>};
            #echo {<cdd>  wsea scout desert    : walk to the hole 26553, then the puzzle (the push right eye updates it)<088>};
        };
    };
};

#alias .wsea_help {
    #echo {     <fff>Westersea Mission Helper<088>};
    #echo {<eaf>---------------------------------------------------------------<088>};
    #echo {<fff>Missions are from Tinny (say missions).  wsea book shows what each open one needs.<088>};
    #echo {};
    #echo {<cdd>wsea book              - read the mission book and show the next step for each<088>};
    #echo {<cdd>wsea turnin            - hand in every finished mission at its giver<088>};
    #echo {<cdd>wsea grind sewer|slum  - repeat a cleanup for rep, handing it in when it hits 100<088>};
    #echo {<cdd>wsea stop              - stop grinding, eavesdropping and the lamp check<088>};
    #echo {<eaf>  Guard and city work<088>};
    #echo {<cdd>wsea reports           - bot: walk the walls, grab report at every desk<088>};
    #echo {<cdd>wsea fortify / chests  - give Bern the note / fill the six weapon chests<088>};
    #echo {<cdd>wsea lieutenant        - enter alley to the dead lieutenant<088>};
    #echo {<cdd>wsea widow             - say death to Weave Poll<088>};
    #echo {<cdd>wsea eavesdrop         - eavesdrop on the merchants until it updates<088>};
    #echo {<cdd>wsea lamps             - examine each street lamp you walk past (City Volunteers)<088>};
    #echo {<cdd>wsea rolls             - A Hungry Guard: bowls from Bern, rolls from Per, rolls to Tommy<088>};
    #echo {<cdd>wsea excursion         - walk to the hole down to the cubes (Sewer Excursion)<088>};
    #echo {<cdd>wsea scout [town|faeries|wasteland|desert] - walk to where a scout task updates<088>};
    #echo {<eaf>  Main line (in order)<088>};
    #echo {<cdd>wsea visitor 1|2|3     - An Unwelcome Visitor (needs ~100k rep for Sir Michael)<088>};
    #echo {<cdd>wsea tapestry          - Find the Church Tomb: tapestry puzzle, rope and candle<088>};
    #echo {<cdd>wsea belfry            - cord for the chisel, then the inscription at Alister<088>};
    #echo {<cdd>wsea karithal male|female - Explore Church Tomb: murmur your name at the barrier<088>};
    #echo {<cdd>wsea eggs              - Church Tomb Cleanup: crack eggs (first one is the cocoon)<088>};
    #echo {<cdd>wsea contact           - Make Contact: touch the sphere<088>};
    #echo {<cdd>wsea presence          - Assist Presence: chirping box and library buttons<088>};
    #echo {<eaf>---------------------------------------------------------------<088>};
};

#alias {wsea} {
    #switch {"%1"} {
        #case {""} {.wsea_help};
        #case {"help"} {.wsea_help};
        #case {"book"} {#var wsea[then] show;flip};
        #case {"turnin"} {#var wsea[then] turnin;flip};
        #case {"grind"} {.wsea_grind %2};
        #case {"stop"} {.wsea_grind_stop};
        #case {"reports"} {+wsea-reports};
        #case {"fortify"} {.wsea_fortify};
        #case {"chests"} {.wsea_chests};
        #case {"lieutenant"} {#map run 45578};
        #case {"widow"} {#map run 5914;say death};
        #case {"eavesdrop"} {.wsea_eavesdrop};
        #case {"lamps"} {#var wsea[lamps] 1;#echo {<afa>Westersea: examining street lamps as you pass them.<088>}};
        #case {"rolls"} {.wsea_rolls};
        #case {"excursion"} {#map run 6157;#echo {<ffa>Now go to Alister and wsea turnin.<088>}};
        #case {"scout"} {.wsea_scout %2};
        #case {"visitor"} {.wsea_visitor %2};
        #case {"tapestry"} {.wsea_tapestry};
        #case {"belfry"} {.wsea_belfry};
        #case {"karithal"} {.wsea_karithal %2};
        #case {"eggs"} {.wsea_eggs};
        #case {"contact"} {.wsea_contact};
        #case {"presence"} {.wsea_presence};
        #default {#echo {<ffa>wsea: unknown command %1 - type wsea for the list<088>}};
    };
};

#class {area_westersea} {close};
