#class {again_fremen_advance} {kill};
#class {again_fremen_advance} {open};

#NOP -- Strategy autoadvance: after each kill, raise a stat from fremen_adv_stats while the level has stat raises left;
#NOP -- (cheapest first, list order on ties), and level up once it has none;
#NOP -- Override the list in chars/again/guilds/fremen.tin with a #var fremen_adv_stats line, stats separated by semicolons;
#var fremen_adv_stats {con;dex};
#var my[fremen][adv][pending] 0;

#NOP -- Kill messages;
#action {^You need %S experience to achieve your next level.$} {
    #var tmpXp %1;
    #replace tmpXp {,} {};
    #var my[fremen][adv][need] $tmpXp;
} {2};

#action {^You have %S to spend.$} {
    #var tmpXp %1;
    #replace tmpXp {,} {};
    #var my[fremen][adv][spend] $tmpXp;
    checkStrategy {autoadvance} {.fadv_check};
} {2};

#NOP -- 'check cost' table;
#action {^ [%*]%s%w%s[%s%d]%s%S experience points$} {
    #format tmpStat {%l} {%3};
    #format tmpStat {%.3s} {$tmpStat};
    #var tmpXp %8;
    #replace tmpXp {,} {};
    #var my[fremen][adv][cost][$tmpStat] $tmpXp;
} {2};

#action {You may advance %d stat} {
    #var my[fremen][adv][slots] %1;
    #var my[fremen][adv][pending] 0;
} {2};

#action {You are unable to advance any stats at your current level.} {
    #var my[fremen][adv][slots] 0;
    #var my[fremen][adv][pending] 0;
} {2};

#NOP -- Results: read the table again;
#action {^Your body becomes stronger and more powerful.$} {.fadv_done} {2};
#action {^You become more nimble in skill and execution.$} {.fadv_done} {2};
#action {^You become stronger in body and soul.$} {.fadv_done} {2};
#action {^You become more aware of the world around you.$} {.fadv_done} {2};
#action {^You gain new insight on the world and a stronger will.$} {.fadv_done} {2};
#action {^You gain new understanding and skill in the dealings with others.$} {.fadv_done} {2};
#action {^You do not have enough experience to %w your %w.$} {.fadv_done} {2};
#action {^Welcome to your new level} {.fadv_done} {2};
#action {^You don't have enough experience.$} {.fadv_done} {2};

#alias {.fadv_done} {
    #if {$my[fremen][adv][pending]} {#send {!check cost}};
};

#alias {.fadv_check} {
    #if {$idle_flag || $my[fremen][adv][pending]} {#return};
    #var my[fremen][adv][pending] 1;
    #NOP -- Clears itself if the table never comes back;
    #delay {fadvPending} {#var my[fremen][adv][pending] 0} {20};
    #if {!&my[fremen][adv][slots]} {
        #send {!check cost};
        #return;
    };
    #if {$my[fremen][adv][slots] > 0} {
        #var tmpStat {};
        #foreach {$fremen_adv_stats} tmpKey {
            #if {&my[fremen][adv][cost][$tmpKey] && $my[fremen][adv][cost][$tmpKey] <= $my[fremen][adv][spend]} {
                #if {"$tmpStat" == ""} {
                    #var tmpStat $tmpKey;
                } {
                    #if {$my[fremen][adv][cost][$tmpKey] < $my[fremen][adv][cost][$tmpStat]} {#var tmpStat $tmpKey};
                };
            };
        };
        #if {"$tmpStat" != ""} {
            #format tmpXp {%g} {$my[fremen][adv][cost][$tmpStat]};
            #echo {<cfb>autoadvance: $tmpStat for $tmpXp xp<088>};
            #send {!advance $tmpStat};
            #return;
        };
    } {
        #if {$my[fremen][adv][need] < 0} {
            #echo {<cfb>autoadvance: level<088>};
            #line oneshot #action {^Are you sure you want to advance your level?} {#send {!y}} {2};
            #send {!advance};
            #return;
        };
    };
    #NOP -- Nothing to buy yet: save up;
    #var my[fremen][adv][pending] 0;
    #undelay fadvPending;
};

#class {again_fremen_advance} {close};
