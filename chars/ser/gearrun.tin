#class {gearrun_steps} {kill}
#class {gearrun_steps} {open}

#NOP -- Ser's gear run, easiest mobs first. See common/bot/gearrun.tin for the;
#NOP -- fields. Priority is STR/CON (healing, defense) then WIS/DEX/CHA (damage);
#NOP --;
#NOP -- The wear lines use best-guess item keywords. Check them with look on the;
#NOP -- first run and fix any that do not match. Upgrading a piece you already;
#NOP -- wear (same keyword, better version) is left to a note, since wear would;
#NOP -- just pick whichever copy is first in the inventory;

#NOP -- reset is the dungeon timer in minutes from wemudtogether;

#list gearrun_steps clear;

#NOP -- 7M-16M, no scaler. Random drops, 3 hour reset. Covers most slots;
#NOP -- Gloves +10 STR, breastplate +10 CON, boots +10 DEX;
#list gearrun_steps add {{
    {key} {spirit}
    {name} {Tree of Life 2.0: Spirit set}
    {bot} {angels2}
    {reset} {180}
    {wear} {wear gloves;wear breastplate;wear boots;wear cloak;wear amulet;wear bracers;wear greaves;wear helmet;wear shield}
    {note} {Drops are random. gearrun undo 1 and rerun after the 3 hour reset for missing pieces.}
}};

#NOP -- Scaler 150: legendary +15 stats, unbreakable, 19M-90M mobs. Slow going;
#NOP -- this early, but it skips a second Care Bears run. Cupcake is;
#NOP -- bind-on-pickup. Galoshes +15 STR replace the Spirit boots. Headband;
#NOP -- +15 WIS replaces the Spirit helmet, which has no bonus. Luck Bear hide;
#NOP -- is main armor;
#list gearrun_steps add {{
    {key} {carebears150}
    {name} {Care Bears @150: galoshes, headband, hide, cupcake}
    {bot} {carebears-all}
    {dkey} {carebears}
    {scaler} {150}
    {reset} {120}
    {get} {get cupcake}
    {wear} {eat cupcake;remove boots;wear galoshes;remove helmet;wear headband;wear hide}
    {note} {Skip NoHeart's Amulet: 15/15 regen but -20 to every resist.}
}};

#NOP -- 12M-58M. Myril shield 199, Myril Aura 150 (other slot). Unbreakable;
#list gearrun_steps add {{
    {key} {murus}
    {name} {Murus Faralain 2.0: Myril shield and aura}
    {bot} {murus2}
    {wear} {remove shield;wear myril shield;wear aura}
    {note} {Check that the murus2 bot kills whatever drops the Myril gear. Skip the light purple cloak, it cannot be removed without quitting.}
}};

#NOP -- Scaler 150, up to ~129M. Bodyarmor (65 edged/blunt, 50 energy, 30 the;
#NOP -- rest) and Forceshield resists are the same at every scaler, but the;
#NOP -- Forceshield block chance (10% at 149+) and flamethrower WC grow with it.;
#NOP -- All three are bind-on-pickup. aegis-7 clears the level 7 vault but does;
#NOP -- not fight Roosevelt, so he is added here. It attacks him on arrival,;
#NOP -- before its own nod step, so the nod is sent as the fight starts (nod;
#NOP -- works mid fight) to get the passcard. His flamethrower is picked up by;
#NOP -- the get after the kill. Bodyarmor replaces the Luck Bear hide;
#list gearrun_steps add {{
    {key} {aegis150}
    {name} {Aegis Global @150: bodyarmor, forceshield, flamethrower}
    {bot} {aegis-7}
    {dkey} {aegis}
    {scaler} {150}
    {reset} {240}
    {get} {get bodyarmor;get forceshield;get flamethrower}
    {mobs} {{Master Gunnery Sergeant Roosevelt Brown}{roosevelt}}
    {fight} {{roosevelt}{nod}}
    {wear} {remove hide;wear bodyarmor}
    {note} {Forceshield is kept in inventory: the Myril shield has more resists, the Forceshield more block.}
}};

#NOP -- Scaler 150: Balangool armor, 220 resist total per piece. Orange capsules;
#NOP -- give the massive hp/sp regen version;
#list gearrun_steps add {{
    {key} {sectionz150}
    {name} {Section Z @150: figurine and capsules for Balangool}
    {bot} {sectionz}
    {dkey} {sectionz}
    {scaler} {150}
    {reset} {480}
    {note} {Make the Balangool helmet/boots/gloves from the Brain's figurine by hand afterward.}
}};

#NOP -- Lucanus set, level 100: breastplate 225, cloak 200, sash 150, gloves;
#NOP -- 150, greaves 125, ring 100. Syrena and Satarus drop pieces;
#list gearrun_steps add {{
    {key} {lucanus}
    {name} {Serinth castle: Lucanus set}
    {bot} {serinth-castle}
    {note} {Wear the Lucanus pieces by hand: they replace the Spirit breastplate, cloak and greaves.}
}};

#class {gearrun_steps} {close}
