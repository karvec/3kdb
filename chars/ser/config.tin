#class {player_config} {kill}
#class {player_config} {open}

#ALIAS {postload}
{
     #map flag static on;
     #map flag vtmap on;
     #map flag unicodegraphics on;
     #map flag terrain on;
     #map flag direction on;
     #delay {1} {hp}
};

#NOP -- Bot Config;
#var mob_kill_action 1;
#alias {.pre_fight_check} {#nop};

#alias {.pre_bot_check} {#NOP};

#NOP -- Psicorps: rebuild implants from gs at login so the Vg slot picks up improved vigor;
#NOP -- Delayed past the login profs check so the two outputs don't overlap;
#delay {ser_gs_powers} {gs_powers} {5};


#class {player_config} {close}