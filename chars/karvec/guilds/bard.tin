#class {player_guild} {kill}
#class {player_guild} {open}

#NOP -- Karvec's bard extras. config.tin reads this after the guild scripts at login and on gswap;

#class {player_guild} {close}

#NOP -- Put up defenses at login. This file is also read on .reload and gswap, so a flag in its own class;
#NOP -- (which those don't kill) keeps it to once per session. prots_songs is a toggle and the song flags;
#NOP -- are saved between logins, so only run it when the songs are off;
#if {"$karvec_login[prots]" != "1"} {
    #class {karvec_login} {open};
    #var karvec_login[prots] 1;
    #class {karvec_login} {close};
    #delay {karvec_prots} {
        prots_spells;
        #if {!$defs[ag] && !$defs[om]} {prots_songs};
    } {3};
};
